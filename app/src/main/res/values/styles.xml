<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#202020</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAFAF8</item>
        <item name="android:navigationBarColor">#FAFAF8</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FAFAF8</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#EEEEEE</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#171717</item>
        <item name="android:navigationBarColor">#171717</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#171717</item>
    </style>
</resources>